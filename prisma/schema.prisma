// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(WAITER)
  isActive  Boolean  @default(true)  // false = deactivated (soft delete)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ordersCreated     Order[]   @relation("OrderWaiter")
  ordersHandled     Order[]   @relation("OrderCashier")
  paymentsProcessed Payment[]
  auditLogs         AuditLog[]
  expenses          Expense[]
}

enum Role {
  ADMIN
  WAITER
  CASHIER
}

enum OrderStatus {
  OPEN              // Active ordering session (waiter can add items)
  AWAITING_PAYMENT  // Bill requested/generated, locked unless reopened
  PAID              // Settled
  CANCELLED         // Voided
}

enum TicketStatus {
  PENDING
  COOKING
  READY
  SERVED
}

enum PrintStatus {
  PENDING
  PRINTED
  FAILED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum ItemStatus {
  ACTIVE
  VOIDED
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  orderType     OrderType   @default(DINE_IN)
  tableNumber   String?     // e.g. "4" or "Takeaway" (Legacy/Reference)
  
  // Seating Relationship
  tableId       String?
  table         Table? @relation(fields: [tableId], references: [id])
  
  status        OrderStatus   @default(OPEN)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  
  guestCount    Int?
  
  subtotal      Decimal     @db.Decimal(12, 2)
  
  // Financial Snapshots (Locked at time of order)
  vatRateSnapshot      Decimal?   @default(15.0) @db.Decimal(5, 2)
  nhilRateSnapshot     Decimal?   @default(2.5)  @db.Decimal(5, 2)
  getfundRateSnapshot  Decimal?   @default(2.5)  @db.Decimal(5, 2)
  serviceRateSnapshot  Decimal?   @default(5.0)  @db.Decimal(5, 2)
  
  vatAmount            Decimal?   @default(0)    @db.Decimal(12, 2)
  nhilAmount           Decimal?   @default(0)    @db.Decimal(12, 2)
  getfundAmount        Decimal?   @default(0)    @db.Decimal(12, 2)
  serviceAmount        Decimal?   @default(0)    @db.Decimal(12, 2)
  discountRateSnapshot Decimal?   @default(0)    @db.Decimal(5, 2)
  discountAmount       Decimal?   @default(0)    @db.Decimal(12, 2)

  total         Decimal     @db.Decimal(12, 2)
  
  // Soft delete
  deletedAt     DateTime?
  
  // Relations
  waiterId      String?
  waiter        User?       @relation("OrderWaiter", fields: [waiterId], references: [id])
  
  cashierId     String?
  cashier       User?       @relation("OrderCashier", fields: [cashierId], references: [id])
  
  items         OrderItem[]
  tickets       OrderTicket[]
  payments      Payment[]
  auditLogs     AuditLog[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Table {
  id        String      @id @default(uuid())
  name      String      @unique // e.g. "Table 1", "VIP 5"
  isActive  Boolean     @default(true)
  
  orders    Order[]
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  MOMO
  CARD
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  
  cashierId String
  cashier   User          @relation(fields: [cashierId], references: [id])
  
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?       // e.g. MoMo transaction ID or Card Auth Code
  
  createdAt DateTime      @default(now())
}

model OrderTicket {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketNumber Int          
  status       TicketStatus @default(PENDING)
  printStatus  PrintStatus  @default(PENDING)
  notes        String?      
  items        OrderItem[]
  
  deletedAt    DateTime?    
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  ticketId   String?
  ticket     OrderTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  
  name       String   // Snapshot of name at time of purchase
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  status     ItemStatus @default(ACTIVE)
  
  deletedAt  DateTime?    
  createdAt  DateTime @default(now())
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  isActive    Boolean     @default(true)
  basePrice   Decimal?    @db.Decimal(12, 2)  // Converted to Decimal
  images      String[]    // Array of ImageKit URLs/paths
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Settings {
  id              String   @id @default("GLOBAL")
  storeName       String   @default("Chez Keke")
  storeTagline    String   @default("The Spirit of Africa in Every Grain")
  
  isTaxEnabled    Boolean  @default(true)
  isInclusive     Boolean  @default(false)

  vatRate         Float    @default(15.0)
  nhilRate        Float    @default(2.5)
  getfundRate     Float    @default(2.5)

  serviceCharge   Float    @default(5.0)
  discountRate    Float    @default(0)

  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "REOPEN_BILL", "VOID_ITEM", "TRANSFER_TABLE"
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  details   String?  
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id           String          @id @default(uuid())
  amount       Decimal         @db.Decimal(12, 2) // Converted to Decimal
  description  String
  date         DateTime
  isRecurring  Boolean         @default(false)
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedById String
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
